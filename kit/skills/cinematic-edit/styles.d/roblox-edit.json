{
 "name": "roblox-edit",
 "aliases": [
  "roblox",
  "roblox-edits",
  "roblox-montage"
 ],
 "about": "Roblox / gaming short-form edit cut to a guitar cover: very fast beat cuts, flashes, punch-ins, glitch. ASSUMED from the genre, not measured from a video: run study_video.py on a real example to replace it",
 "format": "9:16",
 "reframe": {
  "mode": "cover",
  "x": 0.5,
  "bg": "blur"
 },
 "look": {
  "grain": 0.04,
  "vignette": 0.35,
  "bloom": 0.35,
  "letterbox": 0.0,
  "beat_zoom": 0.04
 },
 "acts": [
  {
   "name": "intro",
   "f": 0,
   "look": "film",
   "drone": 0.1,
   "heart_bpm": 0
  },
  {
   "name": "build",
   "f": 0.08,
   "look": "vivid",
   "drone": 0.3,
   "heart_bpm": 0
  },
  {
   "name": "drop",
   "f": 0.2,
   "look": "vivid",
   "drone": 0.6,
   "heart_bpm": 0
  },
  {
   "name": "outro",
   "f": 0.92,
   "look": "film",
   "drone": 0.15,
   "heart_bpm": 0
  }
 ],
 "events": {
  "mode": "beats",
  "per_min": 34,
  "gap": 0.5,
  "big_frac": 0.12,
  "ramps": 2,
  "riser": 0.8,
  "fx_big": [
   "punch",
   "flash",
   "chroma",
   "glitch"
  ],
  "fx_mid": [
   "punch",
   "chroma"
  ],
  "fx_small": [
   "punch"
  ],
  "sfx": [
   "impact",
   "tick",
   "tick"
  ],
  "every": 2
 },
 "visualizer": null,
 "audio": {
  "game_db": -12,
  "music_db": -5,
  "duck_db": -3,
  "sfx_db": -8,
  "lufs": -14,
  "mode": "music"
 },
 "pacing": "cut every 2 beats (every beat in the drop); a flash or glitch on each phrase start; slow-mo on the clip right before the drop; keep game sound low, the guitar leads",
 "workflow": [
  "montage.py --every 2 with the guitar cover",
  "analyze --style roblox-edit --music track",
  "preview",
  "final",
  "export"
 ]
}